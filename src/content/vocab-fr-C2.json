eticulous","Une étude méticuleuse."],["examiner minutieusement","to scrutinize","Examinez minutieusement le contrat."],["primordial / capital","paramount","La sécurité est primordiale."],["atténuer","to mitigate","Atténuer les risques."],["inhérent","inherent","Les risques inhérents au métier."],["exacerber / aggraver","to exacerbate","La crise a exacerbé les inégalités."],["saillant / marquant","salient","Les points saillants."],["par excellence / typique","quintessential","Le plat belge par excellence."],["juxtaposer","to juxtapose","L'auteur juxtapose passé et présent."],["la dichotomie","dichotomy","Une fausse dichotomie."],["corroborer","to corroborate","Les témoins ont corroboré son récit."],["bien que / quoique","albeit","Un succès, quoique modeste."],["jusqu'ici / jusqu'à présent","heretofore","Un fait jusqu'ici inconnu."],["incarner / symboliser","to epitomize","Elle incarne l'élégance."],["magnanime","magnanimous","Un geste magnanime."]]]